# Postgres credentials shared across the three databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Comma-separated list of allowed frontend origins for the API Gateway CORS.
# Default already allows the Next.js dev server.
CORS_ORIGINS=http://localhost:3000

# Per-service overrides (only used when running services outside docker-compose).
# Tortoise expects the `postgres://` scheme.
# DATABASE_URL=postgres://postgres:password@localhost:5433/user_db
# USER_SERVICE_URL=http://localhost:8001
# PRODUCT_SERVICE_URL=http://localhost:8002
# ORDER_SERVICE_URL=http://localhost:8003
