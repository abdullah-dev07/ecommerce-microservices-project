# Most rules live in the repo-root .gitignore.
# This file covers things that may appear when running this service in isolation.

# Local virtual env
.venv/
venv/

# Bytecode
__pycache__/
*.pyc

# Per-service env overrides (only the example is committed)
.env
.env.local
!.env.example

# Aerich migration bytecode (the .py files themselves are committed)
migrations/__pycache__/
migrations/models/__pycache__/
